-- FPS BOOST
local function FPSBoost()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Material == Enum.Material.Grass or obj.Material == Enum.Material.Fabric) then
            obj.Material = Enum.Material.SmoothPlastic
        end
    end
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 99999
    pcall(function() settings().Rendering.QualityLevel = 1 end)
    StarterGui:SetCore("SendNotification", {Title = "YinYang FPS Boost", Text = "Применен", Duration = 2})
end

-- TP TO CURSOR
local function TeleportToCursor()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local target = Mouse.Hit.Position + Vector3.new(0, 3, 0)
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(target)
    end
    StarterGui:SetCore("SendNotification", {Title = "YinYang TP", Text = "Телепорт", Duration = 2})
end

-- CLEANUP
function CleanupAll()
    FlyEnabled = false; DisableFly()
    NoClipEnabled = false; DisableNoClip()
    ESPEnabled = false; DisableESP()
    SpeedHackEnabled = false
    InfiniteJumpEnabled = false
    AimbotEnabled = false
    GodModeEnabled = false
    AntiAFKEnabled = false
    FullBrightEnabled = false
    if JumpConnection then JumpConnection:Disconnect() end
    if AimbotConnection then AimbotConnection:Disconnect() end
    if AntiAFKConnection then AntiAFKConnection:Disconnect() end
    if Lighting:FindFirstChild("YinYang_Brightness") then Lighting.YinYang_Brightness:Destroy() end
end

-- RESPAWN HANDLER
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.3)
    if FlyEnabled then FlyEnabled = false; task.wait(0.1); FlyEnabled = true; EnableFly() end
    if NoClipEnabled then NoClipEnabled = false; task.wait(0.1); NoClipEnabled = true; EnableNoClip() end
    if GodModeEnabled then
        local hum = char:WaitForChild("Humanoid", 3)
        if hum then hum.MaxHealth = math.huge; hum.Health = math.huge end
    end
end)

