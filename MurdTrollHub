-- NOCLIP
local function EnableNoClip()
    NoClipEnabled = true
    if NoclipConnection then NoclipConnection:Disconnect() end
    NoclipConnection = RunService.Stepped:Connect(function()
        if not NoClipEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide == true then
                part.CanCollide = false
            end
        end
    end)
    StarterGui:SetCore("SendNotification", {Title = "YinYang NoClip", Text = "ВКЛЮЧЕН", Duration = 2})
end

local function DisableNoClip()
    NoClipEnabled = false
    if NoclipConnection then NoclipConnection:Disconnect(); NoclipConnection = nil end
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end
    StarterGui:SetCore("SendNotification", {Title = "YinYang NoClip", Text = "ВЫКЛЮЧЕН", Duration = 2})
end

-- FLY
local function OnFlyMoveAction(actionName, inputState, inputObject)
    if not FlyEnabled then return end
    if inputState == Enum.UserInputState.Begin or inputState == Enum.UserInputState.Change then
        MoveVector = Vector3.new(inputObject.Position.X, 0, inputObject.Position.Y)
    elseif inputState == Enum.UserInputState.End then
        MoveVector = Vector3.zero
    end
end

local function OnFlyUpAction(actionName, inputState, inputObject)
    if not FlyEnabled or not BodyVelocity then return end
    if inputState == Enum.UserInputState.Begin then
        BodyVelocity.Velocity = BodyVelocity.Velocity + Vector3.new(0, FLY_SPEED, 0)
    elseif inputState == Enum.UserInputState.End then
        BodyVelocity.Velocity = BodyVelocity.Velocity - Vector3.new(0, FLY_SPEED, 0)
    end
end

local function OnFlyDownAction(actionName, inputState, inputObject)
    if not FlyEnabled or not BodyVelocity then return end
    if inputState == Enum.UserInputState.Begin then
        BodyVelocity.Velocity = BodyVelocity.Velocity - Vector3.new(0, FLY_SPEED, 0)
    elseif inputState == Enum.UserInputState.End then
        BodyVelocity.Velocity = BodyVelocity.Velocity + Vector3.new(0, FLY_SPEED, 0)
    end
end

local function EnableFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    hum.PlatformStand = true
    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.MaxForce = Vector3.new(400000, 400000, 400000)
    BodyVelocity.Velocity = Vector3.zero
    BodyVelocity.P = 5000
    BodyVelocity.Parent = hrp
    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
    BodyGyro.P = 30000
    BodyGyro.CFrame = hrp.CFrame
    BodyGyro.Parent = hrp
    ContextActionService:BindAction(FlyAction .. "Move", OnFlyMoveAction, false,
        Enum.KeyCode.Thumbstick1, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D)
    ContextActionService:BindAction(FlyAction .. "Up", OnFlyUpAction, false,
        Enum.KeyCode.ButtonA, Enum.KeyCode.Space)
    ContextActionService:BindAction(FlyAction .. "Down", OnFlyDownAction, false,
        Enum.KeyCode.ButtonX, Enum.KeyCode.LeftShift)
    RunService.Heartbeat:Connect(function()
        if not FlyEnabled or not BodyVelocity or not BodyGyro then return end
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
        local cameraCF = Camera.CFrame
        local forward = Vector3.new(cameraCF.LookVector.X, 0, cameraCF.LookVector.Z).Unit
        local right = Vector3.new(cameraCF.RightVector.X, 0, cameraCF.RightVector.Z).Unit
        local moveDirection = (forward * -MoveVector.Z) + (right * MoveVector.X)
        if moveDirection.Magnitude > 0 then
            BodyVelocity.Velocity = Vector3.new(moveDirection.Unit.X * FLY_SPEED, BodyVelocity.Velocity.Y, moveDirection.Unit.Z * FLY_SPEED)
        else
            BodyVelocity.Velocity = Vector3.new(0, BodyVelocity.Velocity.Y, 0)
        end
        BodyGyro.CFrame = CFrame.new(Vector3.zero, cameraCF.LookVector * Vector3.new(1, 0, 1) + Vector3.new(0, 1, 0))
    end)
    StarterGui:SetCore("SendNotification", {Title = "YinYang Fly", Text = "ВКЛЮЧЕН | Joy/WASD | A/Space Up | X/Shift Down", Duration = 3})
end

local function DisableFly()
    FlyEnabled = false
    pcall(function() ContextActionService:UnbindAction(FlyAction .. "Move") end)
    pcall(function() ContextActionService:UnbindAction(FlyAction .. "Up") end)
    pcall(function() ContextActionService:UnbindAction(FlyAction .. "Down") end)
    if BodyVelocity then BodyVelocity:Destroy(); BodyVelocity = nil end
    if BodyGyro then BodyGyro:Destroy(); BodyGyro = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    StarterGui:SetCore("SendNotification", {Title = "YinYang Fly", Text = "ВЫКЛЮЧЕН", Duration = 2})
end

-- ESP
local function CreateESP(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end
    local function setupESP()
        if not player.Character or not player.Character:FindFirstChild("Head") then return end
        local Billboard = Instance.new("BillboardGui")
        Billboard.Adornee = player.Character.Head
        Billboard.Size = UDim2.new(0, 200, 0, 30)
        Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        Billboard.AlwaysOnTop = true
        local Frame = Instance.new("Frame")
        Frame.Size = UDim2.new(1, 0, 1, 0)
        Frame.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
        Frame.BackgroundTransparency = 0.4
        Frame.BorderSizePixel = 1
        Frame.BorderColor3 = Color3.fromRGB(180, 0, 0)
        Frame.Parent = Billboard
        local Text = Instance.new("TextLabel")
        Text.Size = UDim2.new(1, 0, 1, 0)
        Text.BackgroundTransparency = 1
        Text.Text = player.Name
        Text.TextColor3 = Color3.fromRGB(255, 255, 255)
        Text.TextSize = 12
        Text.Font = Enum.Font.Code
        Text.Parent = Frame
        Billboard.Parent = CoreGui
        ESPObjects[player] = {billboard = Billboard, connection = nil}
        local hum = player.Character:FindFirstChild("Humanoid")
        if hum then
            local conn
            conn = hum:GetPropertyChangedSignal("Health"):Connect(function()
                if player.Character and player.Character:FindFirstChild("Humanoid") then
                    Text.Text = player.Name .. " [" .. math.floor(hum.Health) .. " HP]"
                end
            end)
            ESPObjects[player].connection = conn
            Text.Text = player.Name .. " [" .. math.floor(hum.Health) .. " HP]"
        end
    end
    if player.Character then setupESP() end
    player.CharacterAdded:Connect(function() task.wait(0.5); setupESP() end)
end

local function EnableESP()
    ESPEnabled = true
    for _, player in pairs(Players:GetPlayers()) do CreateESP(player) end
    Players.PlayerAdded:Connect(function(player) if ESPEnabled then CreateESP(player) end end)
    Players.PlayerRemoving:Connect(function(player)
        if ESPObjects[player] then
            if ESPObjects[player].connection then ESPObjects[player].connection:Disconnect() end
            ESPObjects[player].billboard:Destroy()
            ESPObjects[player] = nil
        end
    end)
    StarterGui:SetCore("SendNotification", {Title = "YinYang ESP", Text = "ВКЛЮЧЕН", Duration = 2})
end

local function DisableESP()
    ESPEnabled = false
    for player, data in pairs(ESPObjects) do
        if data.connection then data.connection:Disconnect() end
        if data.billboard then data.billboard:Destroy() end
    end
    ESPObjects = {}
    StarterGui:SetCore("SendNotification", {Title = "YinYang ESP", Text = "ВЫКЛЮЧЕН", Duration = 2})
end
