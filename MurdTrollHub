local function hasKnife(p)
    if p.Backpack and p.Backpack:FindFirstChild("Knife")then return true end
    if p.Character and p.Character:FindFirstChild("Knife")then return true end;return false
end
local function hasGun(p)
    if p.Backpack and p.Backpack:FindFirstChild("Gun")then return true end
